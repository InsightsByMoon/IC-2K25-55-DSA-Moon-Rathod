#include<iostream>
#define max 5
using namespace std;
class mst
{
    private:
    int top1,top2;
    int a[max];
    int x;
public:
    mst()
    {
        top1=-1;
        top2=max;
    }
    void push1();
    void push2();
    void pop1();
    void pop2();
    void display1();
    void display2();
};
void mst::push1()
{
    if(top1+1==top2)
    {
        cout<<"Stack Overflow\n";
    }
    cout<<"Enter value to push in stack 1: ";
     cin>>x;
    top1++;
    a[top1]=x;
    cout<<x<<" pushed into stack 1\n";
}
void mst::push2()
{
    if(top1+1==top2)
    {
        cout<<"Stack Overflow\n";
    }
    cout<<"Enter value to push in stack 2: ";
     cin>>x;
    top2--;
    a[top2]=x;
    cout<<x<<" pushed into stack 2\n";
}
void mst::pop1()
{
    if(top1==-1)
    {
        cout<<"Stack Underflow\n";
    }
    else
    {
        x=a[top1];
        cout<<x<<" popped from stack 1\n";
        top1--;
    }
}
void mst::pop2()
{
    if(top2==max)
    {
        cout<<"Stack Underflow\n";
    }
    else
    {
        x=a[top2];
        cout<<x<<" popped from stack 2\n";
        top2++;
    }
}
void mst::display1()
{
    if(top1==-1)
    {
        cout<<"Stack 1 is empty\n";
    }
    else
    {
        cout<<"Stack 1 elements are:\n";
        for(int i=top1;i>=0;i--)
            cout<<a[i]<<" ";
        cout<<"\n";
    }
}
void mst::display2()
{
    if(top2==max)
    {
        cout<<"Stack 2 is empty\n";
    }
    else
    {
        cout<<"Stack 2 elements are:\n";
        for(int i=top2;i<max;i++)
            cout<<a[i]<<" ";
        cout<<"\n";
    }
}
int main()
{
    mst s;
    int choice;
    char c;
    do
    {
        cout<<"1. Push in stack 1\n";
        cout<<"2. Push in stack 2\n";
        cout<<"3. Pop from stack 1\n";
        cout<<"4. Pop from stack 2\n";
        cout<<"5. Display stack 1\n";
        cout<<"6. Display stack 2\n";
        cout<<"Enter your choice: ";
        cin>>choice;
        switch(choice)
        {
            case 1:
                s.push1();
                break;
            case 2:
                s.push2();
                break;
            case 3:
                s.pop1();
                break;
            case 4:
                s.pop2();
                break;
            case 5:
                s.display1();
                break;
            case 6:
                s.display2();
                break;
            case 7:
                cout<<"Exiting...\n";
                break;
            default:
                cout<<"Invalid choice\n";
        }
        cout<<"Do you want to continue? (y/n): ";
        cin>>c;
    }while(c=='y'||c=='Y');
}
